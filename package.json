{
  "name": "webclip-to-ai",
  "version": "1.3.1",
  "private": true,
  "description": "选文送 AI：将浏览器选文交给自建接口，或填入 DeepSeek Harness 当前草稿。",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "webclip": {
    "harnessVersion": "1.2.1"
  },
  "scripts": {
    "test": "node tests/run.mjs",
    "test:browser": "node tests/browser/run.mjs",
    "prepare:ocr": "python scripts/prepare-ocr.py",
    "check": "python scripts/prepare-ocr.py --verify && node scripts/check.mjs",
    "build": "python scripts/prepare-ocr.py --verify && python scripts/package.py"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "tesseract.js": "6.0.1"
  }
}
