{
  "manifest_version": 3,
  "name": "选文送 AI",
  "version": "1.3.1",
  "description": "恢复常见网页的选字与右键功能，将选中文字发送到你配置的 AI 智能体接口。",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage", "offscreen"],
  "commands": { "ocr-region": { "suggested_key": { "default": "Alt+Shift+O" }, "description": "框选图片文字并交给 AI" } },
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'" },
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "选文送 AI", "default_popup": "popup.html" },
  "options_page": "options.html"
}
